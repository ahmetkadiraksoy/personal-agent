def compact_object_id(value, prefix):
    match = re.fullmatch(rf"{re.escape(prefix)}_0*(\d+)", str(value or ""))
    return str(int(match.group(1))) if match else str(value or "?")


def show_memory(query=None):
    global _MEMORY_INDEX_MAP

    memories = api("GET", "/memory").get("memories", [])
    _MEMORY_INDEX_MAP = {str(m.get("id")): m.get("id") for m in memories if m.get("id") is not None}

    # A literal memory ID (for example mem_003) opens that exact JSON entry.
    if query and str(query).strip() in _MEMORY_INDEX_MAP:
        memory_id = str(query).strip()
        match = next((m for m in memories if str(m.get("id")) == memory_id), None)
        console.print()
        if not match:
            console.print("[dim]Memory not found.[/dim]\n")
            return
        console.print(Text.assemble((f"[{memory_id}] ", "bold magenta"), (f"({match.get('category','unknown')})", "cyan")))
        console.print(match.get("text", ""))
        console.print()
        return

    if query:
        path = "/memory/search?q=" + urllib.parse.quote(query) + "&limit=5"
        result = api("GET", path)
        results = result.get("memories", [])
        console.print()
        if not results:
            console.print("[dim]No matching memories.[/dim]\n")
            return
        console.print(f"[bold]Memories matching:[/bold] {query}")
        for m in results:
            memory_id = str(m.get("id", "?"))
            score = m.get("similarity")
            suffix = f" [dim]({score:.4f})[/dim]" if isinstance(score, (int, float)) else ""
            console.print(Text.assemble((f"[{memory_id}] ", "bold magenta"), (f"({m.get('category','unknown')})", "cyan"), Text.from_markup(suffix)))
            console.print(m.get("text", ""))
            console.print()
        return

    console.print()
    if not memories:
        console.print("[dim]No persistent memories saved.[/dim]\n")
        return
    for m in memories:
        memory_id = str(m.get("id", "?"))
        console.print(Text.assemble((f"[{memory_id}] ", "bold magenta"), (f"({m.get('category','unknown')})", "cyan")))
        console.print(m.get("text", ""))
        console.print()

def _note_db_id(note):
    """Return the real SQLite notes.id, never a list/display position."""
    db_id = note.get("db_id")
    if db_id is not None:
        return str(db_id)
    # Backward compatibility with an older server that only exposes note_000123.
    value = str(note.get("id", "?")).strip()
    if value.startswith("note_"):
        suffix = value[5:]
        if suffix.isdigit():
            return str(int(suffix))
    return value


def show_notes(query=None):
    global _NOTE_INDEX_MAP

    all_notes = api("GET", "/notes?limit=200").get("notes", [])

    if query and str(query).strip().isdigit():
        show_note(str(query).strip())
        return

    if query:
        path = "/notes/search?q=" + urllib.parse.quote(query) + "&limit=10"
        notes = api("GET", path).get("notes", [])
        console.print()
        if not notes:
            console.print("[dim]No matching notes.[/dim]\n")
            return
        console.print(f"[bold]Notes matching:[/bold] {query}")
        for note in notes:
            note_id = _note_db_id(note)
            score = note.get("similarity")
            suffix = f" [dim]({score:.4f})[/dim]" if isinstance(score, (int, float)) else ""
            path_text = note.get("category_path") or "Uncategorized"
            console.print(Text.assemble((f"[{note_id}] ", "bold magenta"), note.get("title", "Untitled"), Text.from_markup(suffix)))
            console.print(f"    [dim]{path_text}[/dim]")
        console.print()
        return

    categories = api("GET", "/note-categories").get("categories", [])
    console.print()
    if not all_notes:
        console.print("[dim]No notes saved.[/dim]\n")
        return
    console.print(f"[bold]Notes ({len(all_notes)})[/bold]")
    notes_by_category = {}
    for note in all_notes:
        notes_by_category.setdefault(note.get("category_id"), []).append(note)
    children = {}
    category_by_id = {c.get("id"): c for c in categories}
    for cat in categories:
        children.setdefault(cat.get("parent_id"), []).append(cat)

    def print_branch(parent_id=None, depth=0):
        for cat in children.get(parent_id, []):
            indent = "    " * depth
            console.print(f"{indent}[bold]{cat.get('name','Untitled')}/[/bold]")
            for note in notes_by_category.get(cat.get("id"), []):
                note_id = _note_db_id(note)
                console.print(Text.assemble(indent + "    ", (f"[{note_id}] ", "bold magenta"), note.get("title", "Untitled")))
            print_branch(cat.get("id"), depth + 1)

    print_branch(None, 0)
    uncategorized = notes_by_category.get(None, [])
    if uncategorized:
        console.print("[bold]Uncategorized/[/bold]")
        for note in uncategorized:
            note_id = _note_db_id(note)
            console.print(Text.assemble("    ", (f"[{note_id}] ", "bold magenta"), note.get("title", "Untitled")))
    console.print()


def show_note(note_id):
    note_id = str(note_id).strip()
    if not note_id:
        console.print("\n[yellow]Note ID is required.[/yellow]\n")
        return

    note = api("GET", "/notes/" + urllib.parse.quote(note_id)).get("note")
    console.print()
    if not note:
        console.print("[dim]Note not found.[/dim]\n")
        return
    console.print(Text.assemble((f"[{_note_db_id(note)}] ", "bold magenta"), (note.get("title", "Untitled"), "bold")))
    if note.get("category_path"):
        console.print(f"[cyan]Category:[/cyan] {note.get('category_path')}")
    tags = note.get("tags") or []
    if tags:
        console.print(f"[cyan]Tags:[/cyan] {', '.join(map(str, tags))}")
    console.print()
    console.print(Markdown(note.get("content", "")))
    console.print()


