]


class AgentCompleter(Completer):
    """Shell-style, context-aware completion for Agent slash commands."""

    def get_completions(self, document, complete_event):
        text = document.text_before_cursor
        if "\n" in text:
            # Work only within the current line of a multiline prompt.
            text = text.rsplit("\n", 1)[-1]

        # Slash commands may appear anywhere in a normal prompt. Complete the
        # slash expression nearest to the cursor, rather than requiring the
        # entire input to begin with '/'.
        slash_index = text.rfind("/")
        if slash_index < 0:
            return
        fragment = text[slash_index:]

        # Complete the command itself. A slash starts a command token; if the
        # fragment already contains whitespace, handle it as command + arg.
        if " " not in fragment and "\t" not in fragment:
            prefix = fragment.lower()
            for command in COMMANDS:
                if command.startswith(prefix) and command != prefix:
                    yield Completion(command, start_position=-len(fragment))
            return

        command, _, argument = fragment.partition(" ")
        command = command.lower()
        if command not in {
            "/notes", "/memory", "/inbox", "/tasks",
        }:
            return

        try:
            choices = self._number_choices(command)
        except Exception:
            return

        typed = argument.strip()

        # /inbox supports both opening an item directly and management actions:
        #   /inbox <number>
        #   /inbox read|unread|remove <number>
        if command == "/inbox":
            parts = argument.split()
            actions = ("read", "unread", "remove")
            if len(parts) == 0 or (len(parts) == 1 and not argument.endswith(" ")):
                token = parts[0].casefold() if parts else ""
                for action in actions:
                    if action.startswith(token) and action != token:
                        yield Completion(action, start_position=-len(token), display=action)
                if not token or token.isdigit():
                    for number, label in choices:
                        value = str(number)
                        if value.startswith(token) and value != token:
                            yield Completion(value, start_position=-len(token), display=value, display_meta=str(label or ""))
                        elif not token:
                            yield Completion(value, start_position=0, display=value, display_meta=str(label or ""))
                return
            action = parts[0].casefold() if parts else ""
            if action not in actions:
                return
            token = parts[1] if len(parts) > 1 else ""
            if token and not token.isdigit():
                return
            for number, label in choices:
                value = str(number)
                if value.startswith(token) and value != token:
                    yield Completion(value, start_position=-len(token), display=value, display_meta=str(label or ""))
                elif not token:
                    yield Completion(value, start_position=0, display=value, display_meta=str(label or ""))
            return

        # /tasks uses a single command namespace:
        #   /tasks
        #   /tasks run|remove|enable|disable <number>
        if command == "/tasks":
            parts = argument.split()
            actions = ("run", "remove", "enable", "disable")
            if len(parts) == 0 or (len(parts) == 1 and not argument.endswith(" ")):
                token = parts[0].casefold() if parts else ""
                for action in actions:
                    if action.startswith(token) and action != token:
                        yield Completion(action, start_position=-len(token), display=action)
                return
            action = parts[0].casefold() if parts else ""
            if action not in actions:
                return
            token = parts[1] if len(parts) > 1 else ""
            if token and not token.isdigit():
                return
            for number, label in choices:
                value = str(number)
                if value.startswith(token) and value != token:
                    yield Completion(value, start_position=-len(token), display=value, display_meta=str(label or ""))
                elif not token:
                    yield Completion(value, start_position=0, display=value, display_meta=str(label or ""))
            return

        if command not in {"/notes", "/memory"} and typed and not typed.isdigit():
            return

        needle = typed.casefold()
        for number, label in choices:
            value = str(number)
            label_text = str(label or "")

            if command in {"/notes", "/memory"}:
                if needle and needle not in label_text.casefold():
                    continue
                start_pos = -len(argument) if argument else 0
                yield Completion(
                    label_text,
                    start_position=start_pos,
                    display=label_text,
                )
                continue

            if value.startswith(typed) and value != typed:
                yield Completion(
                    value,
                    start_position=-len(typed),
                    display=value,
                    display_meta=label_text,
                )
            elif not typed:
                yield Completion(
                    value,
                    start_position=0,
                    display=value,
                    display_meta=label_text,
                )

    @staticmethod
    def _number_choices(command):
        global _NOTE_INDEX_MAP, _MEMORY_INDEX_MAP, _TASK_INDEX_MAP, _NOTIFICATION_INDEX_MAP

        if command == "/notes":
            items = api("GET", "/notes?limit=200").get("notes", [])
            return [(_note_db_id(item), item.get("title", "Untitled")) for item in items if item.get("id") is not None]

        if command == "/memory":
            items = api("GET", "/memory").get("memories", [])
            _MEMORY_INDEX_MAP = {str(item.get("id")): item.get("id") for item in items if item.get("id") is not None}
            return [
                (str(item.get("id")), f"{item.get('category', 'unknown')}: {str(item.get('text', '')).replace(chr(10), ' ')[:70]}")
                for item in items if item.get("id") is not None
            ]

        if command == "/inbox":
            items = api("GET", "/notifications?unread=false&limit=50").get("notifications", [])
            _NOTIFICATION_INDEX_MAP = {i: item.get("id") for i, item in enumerate(items, 1)}
            return [(i, item.get("title", "Notification")) for i, item in enumerate(items, 1)]

        items = api("GET", "/tasks").get("tasks", [])
        _TASK_INDEX_MAP = {i: item.get("id") for i, item in enumerate(items, 1)}
        return [(i, item.get("name", "Untitled")) for i, item in enumerate(items, 1)]


def api(method, path, payload=None):
    data = None
    headers = {}
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(
        BASE_URL + path,
        data=data,
        headers=headers,
        method=method,
    )
    try:
        with urllib.request.urlopen(request, timeout=600) as response:
            body = response.read().decode("utf-8")
            return json.loads(body) if body else {}
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            detail = json.loads(body).get("detail", body)
        except Exception:
            detail = body
        raise RuntimeError(f"Server error {exc.code}: {detail}") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(
            "Cannot connect to Agent Server at 127.0.0.1:8765. "
            "Make sure agent-server is running"
        ) from exc


def api_stream_chat(message, stateless=False):
    payload = json.dumps({"message": message, "stateless": stateless}).encode("utf-8")
    request = urllib.request.Request(
        BASE_URL + "/chat/stream",
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=600) as response:
            for raw_line in response:
                line = raw_line.decode("utf-8").strip()
                if not line:
                    continue
                event = json.loads(line)
                event_type = event.get("type")
                if event_type == "status":
                    console.print(event.get("message", ""))
                elif event_type == "final":
                    return event
                elif event_type == "error":
                    raise RuntimeError(event.get("error", "Unknown server error"))
        raise RuntimeError("Server stream ended without a final response")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            detail = json.loads(body).get("detail", body)
        except Exception:
            detail = body
        raise RuntimeError(f"Server error {exc.code}: {detail}") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(
            "Cannot connect to Agent Server at 127.0.0.1:8765. "
            "Make sure agent-server is running"
        ) from exc


def clean_citations(text):
    if not text:
        return text
    text = re.sub(r"cite.*?", "", text)
    text = re.sub(r"【turn[^】]+】", "", text)
    text = re.sub(r"[ \t]+([.,;:!?])", r"\1", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


