def resolve_notification_number(display_number):
    global _NOTIFICATION_INDEX_MAP
    try:
        display_number = int(display_number)
    except (TypeError, ValueError):
        return None
    if display_number not in _NOTIFICATION_INDEX_MAP:
        items = api("GET", "/notifications?unread=false&limit=50").get("notifications", [])
        _NOTIFICATION_INDEX_MAP = {i: item.get("id") for i, item in enumerate(items, 1)}
    return _NOTIFICATION_INDEX_MAP.get(display_number)


def manage_notification(action, display_number):
    global _NOTIFICATION_INDEX_MAP
    actual_id = resolve_notification_number(display_number)
    if actual_id is None:
        console.print("\n[dim]Notification not found.[/dim]\n")
        return
    if action == "read":
        api("POST", "/notifications/read", {"ids": [actual_id]})
        console.print(f"\n[green]✓ Inbox entry {display_number} marked read.[/green]\n")
    elif action == "unread":
        api("POST", "/notifications/unread", {"ids": [actual_id]})
        console.print(f"\n[green]✓ Inbox entry {display_number} marked unread.[/green]\n")
    elif action == "remove":
        api("DELETE", f"/notifications/{urllib.parse.quote(str(actual_id))}")
        _NOTIFICATION_INDEX_MAP = {}
        console.print(f"\n[green]✓ Inbox entry {display_number} removed.[/green]\n")


def run_task_now(task_number):
    task_id = resolve_task_number(task_number)
    if task_id is None:
        console.print("\n[dim]Task not found.[/dim]\n")
        return
    console.print(f"\n[cyan]⏰ Running task {task_number} now...[/cyan]")
    result = api("POST", f"/tasks/{urllib.parse.quote(str(task_id))}/run")
    if result.get("notification_created"):
        count = int(result.get("notifications_created", 1) or 1)
        noun = "notification" if count == 1 else "notifications"
        console.print(f"[green]✓ Task completed and {count} {noun} saved.[/green]\n")
    else:
        console.print("[dim]Task completed; there was nothing meaningful to notify.[/dim]\n")


def set_task_enabled(task_number, enabled):
    task_id = resolve_task_number(task_number)
    if task_id is None:
        console.print("\n[dim]Task not found.[/dim]\n")
        return
    result = api("PUT", f"/tasks/{urllib.parse.quote(str(task_id))}/enabled", {"enabled": enabled})
    state = "enabled" if enabled else "disabled"
    console.print(f"\n[green]✓ Task {task_number} {state}.[/green]\n")


def delete_task(task_number):
    task_id = resolve_task_number(task_number)
    if task_id is None:
        console.print("\n[dim]Task not found.[/dim]\n")
        return
    api("DELETE", f"/tasks/{urllib.parse.quote(str(task_id))}")
    console.print(f"\n[green]✓ Task {task_number} deleted.[/green]\n")


def show_usage(stateless=False):
    u = api("GET", f"/usage?stateless={str(stateless).lower()}").get("usage", {})
    console.print()
    console.print("[bold]Stateless Usage[/bold]" if stateless else "[bold]Server Usage[/bold]")
    console.print(f"API requests:   {u.get('api_requests', 0):,}")
    console.print(f"Web searches:   {u.get('web_searches', 0):,}")
    input_tokens = u.get('input_tokens', 0)
    cached_input = u.get('cached_input_tokens', 0)
    uncached_input = max(0, input_tokens - cached_input)
    console.print(f"Input tokens:   {input_tokens:,}")
    console.print(f"Cached input:   {cached_input:,}")
    console.print(f"Uncached input: {uncached_input:,}")
    console.print(f"Output tokens:  {u.get('output_tokens', 0):,}")
    console.print(f"Total tokens:   {u.get('total_tokens', 0):,}")
    estimated_cost = float(u.get("estimated_cost_usd", 0) or 0)
    console.print(f"Estimated cost: ${estimated_cost:.4f}\n")


def show_status(initial=False):
    s = api("GET", "/status")
    if initial:
        console.print("🧠 Agent ready")
        console.print(f"💬 History: {s.get('history_messages',0)} messages")
        console.print()
        console.print("Type /help for commands.\n")
        return

    # /status is meant to be a quick operational snapshot, not a dump of
    # implementation details. Fetch the local collections so the numbers are
    # immediately useful to the user.
    memories = api("GET", "/memory").get("memories", [])
    notes = api("GET", "/notes?limit=200").get("notes", [])
    tasks = api("GET", "/tasks").get("tasks", [])
    unread = api("GET", "/notifications?unread=true&limit=50").get("notifications", [])

    enabled_tasks = sum(1 for task in tasks if task.get("enabled"))
    conversation = "active" if s.get("conversation_active", False) else "new"

    console.print()
    console.print("[bold]Agent Status[/bold]")
    console.print("🟢 Server: [green]online[/green]")
    console.print(
        f"💬 Conversation: {conversation} · "
        f"{s.get('history_messages', 0)} history messages"
    )
    console.print(f"🧠 Memories: {len(memories)}")
    console.print(f"📝 Notes: {len(notes)}")
    console.print(f"🔔 Inbox: {len(unread)} unread")
    console.print(f"📅 Tasks: {enabled_tasks} enabled · {len(tasks)} total")
    console.print()


def main():
    try:
        show_status(initial=True)
        show_notifications(unread_only=True, display_limit=3)
    except Exception as exc:
        console.print(f"[bold red]Error:[/bold red] {exc}")
        return 1

    stateless = False
    bindings = KeyBindings()

    @bindings.add("enter")
    def _(event):
        buffer = event.current_buffer

        # If a /notes or /memory item was explicitly selected from the
        # completion menu, submit its real ID instead of treating the visible
        # label as a semantic-search query. Manually typed text is untouched.
        state = buffer.complete_state
        completion = state.current_completion if state is not None else None
        if completion is not None:
            text = buffer.text
            before_cursor = text[:buffer.cursor_position]
            slash_index = before_cursor.rfind("/")
            fragment = before_cursor[slash_index:] if slash_index >= 0 else ""
            command, sep, argument = fragment.partition(" ")
            command_lower = command.lower()
            if sep and command_lower in {"/notes", "/memory"}:
                selected_label = completion.text
                try:
                    choices = AgentCompleter._number_choices(command_lower)
                    selected_id = next(
                        (str(item_id) for item_id, label in choices
                         if str(label or "") == selected_label),
                        None,
                    )
                except Exception:
                    selected_id = None

                if selected_id is not None:
                    replacement = f"{command} {selected_id}"
                    new_before = before_cursor[:slash_index] + replacement
                    buffer.text = new_before + text[buffer.cursor_position:]
                    buffer.cursor_position = len(new_before)

        buffer.validate_and_handle()

    session = PromptSession(
        multiline=True,
        key_bindings=bindings,
        completer=AgentCompleter(),
        complete_while_typing=False,
    )

    first_prompt = True
    while True:
        if not first_prompt:
            console.rule(style="dim")
            console.print()
        first_prompt = False

        try:
            message = session.prompt("(stateless) >>> " if stateless else ">>> ").strip()
        except KeyboardInterrupt:
            console.print("\nGoodbye.")
            break
        except EOFError:
            console.print("\nGoodbye.")
            break

        if not message:
            continue
        lowered = message.lower()

        if lowered in {"exit", "quit"}:
            if stateless:
                api("DELETE", "/stateless")
                stateless = False
                console.print()
                continue
            console.print("Goodbye.")
            break

        if lowered == "/stateless":
            if not stateless:
                api("POST", "/stateless/start")
                stateless = True
                console.print("\n[dim]Stateless mode. Use /exit or /quit to return.[/dim]\n")
            continue

        if lowered in {"/exit", "/quit"}:
            if stateless:
                api("DELETE", "/stateless")
                stateless = False
                console.print()
                continue
            console.print("Goodbye.")
            break

        try:
            if lowered == "/help":
                show_help(); continue
            if lowered == "/clear":
                api("DELETE", f"/conversation?stateless={str(stateless).lower()}")
                console.print("\n💬 History: 0 messages\n")
                continue
            if lowered == "/history":
                show_history(stateless=stateless); continue
            if lowered == "/memory":
                show_memory(); continue
            if lowered.startswith("/memory "):
                query = message[8:].strip()
                if not query:
                    show_memory()
                else:
                    show_memory(query)
                continue
            if lowered == "/notes":
                show_notes(); continue
            if lowered.startswith("/notes "):
                query = message[7:].strip()
                if not query:
                    show_notes()
                else:
                    show_notes(query)
                continue
            if lowered == "/usage":
                show_usage(stateless=stateless); continue
            if lowered == "/rules":
                show_rules(); continue
            if lowered == "/tasks":
                show_tasks(); continue
            if lowered.startswith("/tasks "):
                task_args = message.split()[1:]
                if len(task_args) == 2 and task_args[1].isdigit():
                    action, number = task_args[0].lower(), task_args[1]
                    if action == "run":
                        run_task_now(number)
                    elif action == "remove":
                        delete_task(number)
                    elif action == "disable":
                        set_task_enabled(number, False)
                    elif action == "enable":
                        set_task_enabled(number, True)
                    else:
                        console.print("\n[yellow]Usage:[/yellow] /tasks | /tasks run <number> | /tasks remove <number> | /tasks disable <number> | /tasks enable <number>\n")
                else:
                    console.print("\n[yellow]Usage:[/yellow] /tasks | /tasks run <number> | /tasks remove <number> | /tasks disable <number> | /tasks enable <number>\n")
                continue
            if lowered == "/inbox":
                show_notifications(unread_only=False); continue
            if lowered.startswith("/inbox "):
                inbox_args = message.split()[1:]
                if len(inbox_args) == 1 and inbox_args[0].isdigit():
                    show_notification(inbox_args[0])
                elif len(inbox_args) == 2 and inbox_args[0].lower() in {"read", "unread", "remove"} and inbox_args[1].isdigit():
                    manage_notification(inbox_args[0].lower(), inbox_args[1])
                else:
                    console.print("\n[yellow]Usage:[/yellow] /inbox <number> | /inbox read <number> | /inbox unread <number> | /inbox remove <number>\n")
                continue
            if lowered == "/status":
                show_status(); continue
            if message.startswith("/"):
                console.print(f"\n[yellow]Unknown command:[/yellow] {message}")
                console.print("Type [bold]/help[/bold] to see available commands.\n")
                continue

            console.print()
            result = api_stream_chat(message, stateless=stateless)
            console.print()
            console.print(Markdown(clean_citations(result.get("answer", ""))))
            console.print()

            timing = result.get("timing") or {}
            local_s = float(timing.get("local_seconds", 0) or 0)
            openai_s = float(timing.get("openai_seconds", 0) or 0)
            total_s = float(timing.get("total_seconds", 0) or 0)
            calls = int(timing.get("openai_calls", 0) or 0)
            searches = int(timing.get("web_searches", 0) or 0)

            console.print(
                f"[dim]⏱ Local: {local_s:.2f}s · "
                f"⏱ OpenAI: {openai_s:.2f}s "
                f"({calls} {'call' if calls == 1 else 'calls'}, "
                f"{searches} {'search' if searches == 1 else 'searches'}) · "
                f"Total: {total_s:.2f}s[/dim]"
            )
            console.print()
            handle_rule_approval(result.get("pending_rule"))

        except Exception as exc:
            console.print(f"\n[bold red]Error:[/bold red] {exc}\n")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
