def handle_rule_approval(proposal):
    if not proposal:
        return
    action = proposal.get("action", "change")
    console.print("\n[bold yellow]⚙ Proposed rule change[/bold yellow]")
    if action == "delete":
        old = proposal.get("old_rule") or {}
        console.print(f"Delete [bold]{old.get('id', proposal.get('rule_id','?'))}[/bold]:")
        console.print(old.get("instruction", ""))
    else:
        if action == "update":
            old = proposal.get("old_rule") or {}
            console.print(f"Rule: [bold]{proposal.get('rule_id','?')}[/bold]")
            console.print(f"[dim]Old: {old.get('instruction','')}[/dim]")
            console.print("New:")
        console.print(proposal.get("instruction", ""))
    console.print()
    answer = input("Apply this rule change? [y/N]: ").strip().lower()
    approved = answer in {"y", "yes"}
    result = api("POST", "/rules/decision", {"approve": approved})
    if approved:
        rule = result.get("rule", {})
        if action == "delete":
            console.print(f"[green]✓ Rule deleted: {rule.get('id','?')}[/green]\n")
        else:
            console.print(f"[green]✓ Rule saved: {rule.get('id','?')}[/green]\n")
    else:
        console.print("[dim]Rule change cancelled.[/dim]\n")


def show_tasks():
