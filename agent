    console.print()


def resolve_task_number(display_number):
    global _TASK_INDEX_MAP
    try:
        display_number = int(str(display_number).strip())
    except (TypeError, ValueError):
        return None
    actual_id = _TASK_INDEX_MAP.get(display_number)
    if actual_id is None:
        tasks = api("GET", "/tasks").get("tasks", [])
        _TASK_INDEX_MAP = {i: task.get("id") for i, task in enumerate(tasks, 1)}
        actual_id = _TASK_INDEX_MAP.get(display_number)
    return actual_id

def show_notifications(unread_only=False, display_limit=None):
    global _NOTIFICATION_INDEX_MAP
    path = f"/notifications?unread={str(unread_only).lower()}&limit=50"
    items = api("GET", path).get("notifications", [])
    _NOTIFICATION_INDEX_MAP = {i: item.get("id") for i, item in enumerate(items, 1)}
    if not items:
        return 0
    console.print()
    console.print(
        f"[bold]🔔 {len(items)} unread notification{'s' if len(items) != 1 else ''}[/bold]"
        if unread_only else f"[bold]Inbox ({len(items)})[/bold]"
    )
    console.print()
    visible_items = items[:display_limit] if display_limit is not None else items
    for index, item in enumerate(visible_items, 1):
        title = item.get("title", "Notification")
        summary = item.get("summary", "")
        if item.get("read_at") is not None:
            console.print(f"[dim][{index}] {title}[/dim]")
            console.print(f"[dim]    {summary}[/dim]")
        else:
            console.print(f"[bold][{index}] {title}[/bold]")
            console.print(f"    {summary}")
        console.print()
    if unread_only:
        if display_limit is not None and len(items) > len(visible_items):
            console.print(f"[dim]Showing {len(visible_items)} most recent · /inbox for all[/dim]\n")
        else:
            console.print("[dim]Use /inbox <number> to read one. Unopened notifications remain unread.[/dim]\n")
    return len(items)


