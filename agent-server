def list_notes(category_id=None, limit=50):
    limit = max(1, min(int(limit), 200))
    category_numeric = _parse_category_id(category_id)
    with _notes_connection() as conn:
        if category_id is not None:
            if category_numeric is None:
                return {"success": False, "error": "Invalid category ID."}
            rows = conn.execute("SELECT * FROM notes WHERE category_id=? ORDER BY updated_at DESC, id DESC LIMIT ?", (category_numeric, limit)).fetchall()
        else:
            rows = conn.execute("SELECT * FROM notes ORDER BY updated_at DESC, id DESC LIMIT ?", (limit,)).fetchall()
        return {"success": True, "notes": [_note_dict(row, conn) for row in rows]}


def search_notes(query, limit=5):
    """Routing search: returns metadata only; full content requires get_note."""
    query = str(query).strip()
    if not query:
        return {"success": False, "error": "Search query cannot be empty."}
    notes = _load_all_notes()
    if not notes:
        return {"success": True, "notes": []}
    limit = max(1, min(int(limit), 5, len(notes)))
    vectors = _sync_note_embeddings(notes)
    model = _get_memory_embedding_model()
    query_vector = model.encode("query: " + query, normalize_embeddings=True, show_progress_bar=False)
    scores = vectors @ query_vector
    ranking = np.argsort(scores)[::-1][:limit]
    results = []
    for index in ranking:
        note = dict(notes[int(index)])
        note.pop("content", None)
        note["similarity"] = round(float(scores[int(index)]), 4)
        results.append(note)
    return {"success": True, "notes": results}


