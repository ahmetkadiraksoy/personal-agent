@app.get("/usage")
def usage(stateless: bool = False):
    bucket = STATELESS_USAGE if stateless else SESSION_USAGE
    result = dict(bucket)

    input_tokens = int(result.get("input_tokens", 0) or 0)
    cached_input_tokens = int(result.get("cached_input_tokens", 0) or 0)
    uncached_input_tokens = max(0, input_tokens - cached_input_tokens)
    output_tokens = int(result.get("output_tokens", 0) or 0)
    web_searches = int(result.get("web_searches", 0) or 0)

    token_cost = (
        (uncached_input_tokens / 1_000_000) * INPUT_PRICE_PER_MILLION
        + (cached_input_tokens / 1_000_000) * CACHED_INPUT_PRICE_PER_MILLION
        + (output_tokens / 1_000_000) * OUTPUT_PRICE_PER_MILLION
    )
    web_search_cost = web_searches * WEB_SEARCH_PRICE_PER_RUN

    result["estimated_token_cost_usd"] = token_cost
    result["estimated_web_search_cost_usd"] = web_search_cost
    result["estimated_cost_usd"] = token_cost + web_search_cost

    return {"usage": result, "stateless": stateless}


