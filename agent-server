def execute_tool(name, arguments, status_callback=None):
    def status(message):
        if status_callback:
            status_callback(message)
        else:
            console.print(f"\n[cyan]{message}[/cyan]")

    if name == "propose_rule_change":
        status("⚙ Preparing rule proposal...")
        return propose_rule_change(**arguments)

    if name == "remember":
        status("💾 Saving memory...")
        return remember(**arguments)

    if name == "get_memories":
        status("🧠 Searching memory...")
        return get_memories(**arguments)

    if name == "update_memory":
        status("🧠 Updating memory...")
        return update_memory(**arguments)

    if name == "delete_memory":
        status("🧠 Deleting memory...")
        return delete_memory(**arguments)

    if name == "list_categories":
        status("📝 Listing note categories...")
        return list_categories()

    if name == "create_category":
        status("📝 Creating note category...")
        return create_category(**arguments)

    if name == "update_category":
        status("📝 Updating note category...")
        return update_category(**arguments)

    if name == "delete_category":
        status("📝 Deleting note category...")
        return delete_category(**arguments)

    if name == "move_note":
        status("📝 Moving note...")
        return move_note(**arguments)

    if name == "create_note":
        status("📝 Saving note...")
        return create_note(**arguments)

    if name == "search_notes":
        status("📝 Searching notes...")
        return search_notes(**arguments)

    if name == "get_note":
        status("📝 Reading note...")
        return get_note(**arguments)

    if name == "list_notes":
        status("📝 Listing notes...")
        return list_notes(**arguments)

    if name == "update_note":
        status("📝 Updating note...")
        return update_note(**arguments)

    if name == "delete_note":
        status("📝 Deleting note...")
        return delete_note(**arguments)

    if name == "create_notification":
        status("🔔 Saving notification...")
        return create_notification(**arguments)

    if name == "create_scheduled_task":
        status("⏰ Scheduling task...")
        return create_scheduled_task(**arguments)

    if name == "get_current_datetime":
        return get_current_datetime()

    if name == "get_calendar_events":
        status("📅 Reading calendar...")
        return get_calendar_events(**arguments)

    if name == "search_calendar_events":
        status("🔎 Searching calendar...")
        return search_calendar_events(**arguments)

    if name == "create_calendar_event":
        status("📅 Creating calendar event...")
        return create_calendar_event(**arguments)

    if name == "update_calendar_event":
        status("📅 Updating calendar event...")
        return update_calendar_event(**arguments)

    if name == "delete_calendar_event":
        status("📅 Deleting calendar event...")
        return delete_calendar_event(**arguments)

    return {"success": False, "error": f"Unknown tool: {name}"}


