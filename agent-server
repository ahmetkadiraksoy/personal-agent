    if not title or not summary or not content:
        return {"success": False, "error": "Notification title, summary, and content are required."}
    notification_id = _save_notification(None, title, summary, content)
    return {
        "success": True,
        "notification_id": notification_id,
        "title": title,
    }


def _parse_scheduled_notifications(answer):
    answer = (answer or "").strip()
    if not answer or answer == "NO_NOTIFICATION":
        return []

    candidate = answer
    if candidate.startswith("```"):
        candidate = re.sub(r"^```(?:json)?\s*", "", candidate, count=1)
        candidate = re.sub(r"\s*```$", "", candidate, count=1)

    try:
        payload = json.loads(candidate)
        raw_items = payload.get("notifications", []) if isinstance(payload, dict) else []
    except Exception:
        raw_items = []

    items = []
    for raw in raw_items[:MAX_SCHEDULED_NOTIFICATIONS]:
        if not isinstance(raw, dict):
            continue
        title = str(raw.get("title", "")).strip()
        summary = " ".join(str(raw.get("summary", "")).split()).strip()
        content = str(raw.get("content", "")).strip()
        if title and summary and content:
            items.append({"title": title, "summary": summary, "content": content})

    if items:
        return items

    # Defensive compatibility fallback for an older SUMMARY/CONTENT response.
    match = re.match(r"^SUMMARY:\s*(.+?)\s*\nCONTENT:\s*\n?(.*)$", answer, flags=re.DOTALL)
    if match:
        summary = " ".join(match.group(1).split()).strip()
        content = match.group(2).strip()
        if summary and content:
            return [{"title": "Scheduled task result", "summary": summary, "content": content}]

    # Last-resort single notification if the model returned useful prose.
    first_line = next((line.strip() for line in answer.splitlines() if line.strip()), "")
    summary = " ".join(first_line.split())[:220].strip()
    if summary:
        return [{"title": "Scheduled task result", "summary": summary, "content": answer}]
    return []


def _run_scheduled_task(task, advance_schedule=False):
    task_id = task.get("id")
    task_id = int(task_id) if task_id is not None else None
    previous = (task.get("last_result") or "").strip()
    previous_context = previous if previous else "(No previous result.)"
    execution_prompt = f"""[SCHEDULED TASK EXECUTION]
This is an automatic scheduled task, not a user request to create another schedule.
Task: {task['name']}

IMPORTANT: Do NOT call create_notification during this scheduled execution.
The scheduler itself will save notifications from your final response.

Instruction:
{task['prompt']}

Previous result:
{previous_context}

If there is nothing meaningful to report, return exactly:
NO_NOTIFICATION

Otherwise return ONLY valid JSON in this exact shape:
{{
  "notifications": [
    {{
      "title": "short notification title",
      "summary": "exactly one concise sentence",
      "content": "full useful notification content"
    }}
  ]
}}

Use ONE notification by default. Split the result only when there are meaningfully distinct
topics or groups and separate notifications materially improve readability. Combine related
findings. Never create more than {MAX_SCHEDULED_NOTIFICATIONS} notifications in one run.
Avoid repeating unchanged information from the previous result when possible.
[/SCHEDULED TASK EXECUTION]"""

    try:
        answer, _ = run_agent(execution_prompt, previous_response_id=None, status_callback=None)
        answer = (answer or "").strip()
        notifications = _parse_scheduled_notifications(answer)
        notification_ids = []
        for item in notifications:
            notification_ids.append(
                _save_notification(task_id, item["title"], item["summary"], item["content"])
            )

        # Kept for direct/manual compatibility only. Queued scheduled runs advance
        # their recurrence when enqueued, not after execution.
        if advance_schedule and task_id is not None:
            now = datetime.now()
            next_run = _calculate_next_run(
                task["frequency"], task["run_time"], task.get("weekday"), now=now
            )
            with _db() as conn:
                conn.execute(
                    "UPDATE scheduled_tasks SET last_run_at=?, next_run_at=?, last_result=? WHERE id=?",
                    (now.isoformat(timespec="seconds"), next_run.isoformat(timespec="seconds"), answer, task_id),
                )
                conn.commit()

        return {
            "success": True,
            "notification_created": bool(notification_ids),
            "notifications_created": len(notification_ids),
            "notification_ids": notification_ids,
            "answer": answer,
            "last_result": answer,
        }
    except Exception as exc:
        console.print(f"[yellow]⚠ Scheduled task {task_id or '?'} failed: {exc}[/yellow]")
        return {"success": False, "error": str(exc)}


def run_scheduled_task_now(task_id):
    try:
        numeric_id = _task_id_number(task_id)
    except ValueError as exc:
        return {"success": False, "error": str(exc)}
    with _db() as conn:
        row = conn.execute("SELECT * FROM scheduled_tasks WHERE id=?", (numeric_id,)).fetchone()
    if not row:
        return {"success": False, "error": "Scheduled task not found."}
    return _run_scheduled_task(dict(row), advance_schedule=False)


def _enqueue_due_tasks():
    now_dt = datetime.now()
    now = now_dt.isoformat(timespec="seconds")
    with _db() as conn:
        conn.execute("BEGIN IMMEDIATE")
        rows = conn.execute(
            "SELECT * FROM scheduled_tasks "
            "WHERE enabled=1 AND next_run_at<=? ORDER BY next_run_at ASC, id ASC",
            (now,),
        ).fetchall()
        for row in rows:
            scheduled_for = row["next_run_at"]
            conn.execute(
                "INSERT OR IGNORE INTO scheduled_task_queue("
                "task_id,task_name,task_prompt,frequency,run_time,weekday,scheduled_for,previous_result"
                ") VALUES(?,?,?,?,?,?,?,?)",
                (
                    row["id"], row["name"], row["prompt"], row["frequency"],
                    row["run_time"], row["weekday"], scheduled_for, row["last_result"],
                ),
            )
            # Advance at enqueue time so the next scheduler poll cannot enqueue
            # the same occurrence again while earlier FIFO work is still running.
            next_run = _calculate_next_run(
                row["frequency"], row["run_time"], row["weekday"], now=now_dt
            )
            conn.execute(
                "UPDATE scheduled_tasks SET next_run_at=? WHERE id=?",
                (next_run.isoformat(timespec="seconds"), row["id"]),
            )
        conn.commit()


def _scheduler_loop():
    # Polling and execution are separate: this thread keeps enqueueing newly due
    # work even while the worker is busy with an older task.
    while not _SCHEDULER_STOP.is_set():
        try:
            _enqueue_due_tasks()
        except Exception as exc:
            console.print(f"[yellow]⚠ Scheduler error: {exc}[/yellow]")
        _SCHEDULER_STOP.wait(SCHEDULER_POLL_SECONDS)


def _claim_next_queued_task():
    with _db() as conn:
        conn.execute("BEGIN IMMEDIATE")
        row = conn.execute(
            "SELECT * FROM scheduled_task_queue WHERE status='queued' "
            "ORDER BY scheduled_for ASC, id ASC LIMIT 1"
        ).fetchone()
        if not row:
            conn.commit()
            return None
        started_at = datetime.now().isoformat(timespec="seconds")
        conn.execute(
            "UPDATE scheduled_task_queue SET status='running', attempts=attempts+1, "
            "started_at=?, last_error=NULL WHERE id=?",
            (started_at, row["id"]),
        )
        conn.commit()
        item = dict(row)
        item["started_at"] = started_at
        return item


def _task_worker_loop():
    while not _SCHEDULER_STOP.is_set():
        job = _claim_next_queued_task()
        if not job:
            _SCHEDULER_STOP.wait(1)
            continue

        task = {
            "id": job["task_id"],
            "name": job["task_name"],
            "prompt": job["task_prompt"],
            "frequency": job["frequency"],
            "run_time": job["run_time"],
            "weekday": job["weekday"],
            "last_result": job["previous_result"],
        }

        with SERVER_LOCK:
            result = _run_scheduled_task(task, advance_schedule=False)

        if result.get("success"):
            finished_at = datetime.now().isoformat(timespec="seconds")
            with _db() as conn:
                # If the task still exists, record completion without changing the
                # already-advanced recurrence.
                if job["task_id"] is not None:
                    conn.execute(
                        "UPDATE scheduled_tasks SET last_run_at=?, last_result=? WHERE id=?",
                        (finished_at, result.get("last_result", ""), job["task_id"]),
                    )
                conn.execute("DELETE FROM scheduled_task_queue WHERE id=?", (job["id"],))
                conn.commit()
        else:
            # Keep failed work in the persistent FIFO. It will retry after a short
            # delay rather than being lost.
            with _db() as conn:
                conn.execute(
                    "UPDATE scheduled_task_queue SET status='queued', started_at=NULL, last_error=? WHERE id=?",
                    (result.get("error", "Unknown task error"), job["id"]),
                )
                conn.commit()
            _SCHEDULER_STOP.wait(min(60, SCHEDULER_POLL_SECONDS))


def start_scheduler():
    global _SCHEDULER_THREAD, _TASK_WORKER_THREAD
    if _SCHEDULER_THREAD and _SCHEDULER_THREAD.is_alive():
        return
    _SCHEDULER_STOP.clear()
    # Capture anything already due before either background loop begins.
    _enqueue_due_tasks()
    _SCHEDULER_THREAD = threading.Thread(
        target=_scheduler_loop, name="agent-scheduler", daemon=True
    )
    _TASK_WORKER_THREAD = threading.Thread(
        target=_task_worker_loop, name="agent-task-worker", daemon=True
    )
    _SCHEDULER_THREAD.start()
    _TASK_WORKER_THREAD.start()
    console.print("[cyan]⏰ Scheduler ready.[/cyan]")



