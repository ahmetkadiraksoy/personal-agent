@app.post("/chat")
def chat(request: ChatRequest):
    message = request.message.strip()
    if not message:
        raise HTTPException(status_code=400, detail="Message cannot be empty")

    with SERVER_LOCK:
        if request.stateless:
            _USAGE_CONTEXT.stateless = True
            try:
                answer, response_id, timing = run_agent(
                    message,
                    previous_response_id=STATELESS_STATE["previous_response_id"],
                )
            finally:
                _USAGE_CONTEXT.stateless = False
            STATELESS_STATE["previous_response_id"] = response_id
            STATELESS_STATE["messages"].append({"role": "user", "content": message})
            STATELESS_STATE["messages"].append({"role": "assistant", "content": answer})
            STATELESS_STATE["last_query"] = message
            return {
                "answer": answer,
                "response_id": response_id,
                "stateless": True,
                "pending_rule": get_pending_rule_change(),
                "timing": timing,
            }

        previous_response_id = get_state("previous_response_id")
        answer, response_id, timing = run_agent(
            message,
            previous_response_id=previous_response_id,
        )
        add_message("user", message)
        add_message("assistant", answer)
        set_state("previous_response_id", response_id)

        return {
            "answer": answer,
            "response_id": response_id,
            "stateless": False,
            "pending_rule": get_pending_rule_change(),
            "timing": timing,
        }


@app.post("/chat/stream")
def chat_stream(request: ChatRequest):
    message = request.message.strip()
    if not message:
        raise HTTPException(status_code=400, detail="Message cannot be empty")

    event_queue = queue.Queue()
    finished = object()

    def emit_status(message):
        event_queue.put({"type": "status", "message": message})

    def worker():
        try:
            with SERVER_LOCK:
                if request.stateless:
                    _USAGE_CONTEXT.stateless = True
                    try:
                        answer, response_id, timing = run_agent(
                            message,
                            previous_response_id=STATELESS_STATE["previous_response_id"],
                            status_callback=emit_status,
                        )
                    finally:
                        _USAGE_CONTEXT.stateless = False
                    STATELESS_STATE["previous_response_id"] = response_id
                    STATELESS_STATE["messages"].append({"role": "user", "content": message})
                    STATELESS_STATE["messages"].append({"role": "assistant", "content": answer})
                    STATELESS_STATE["last_query"] = message
                    result = {
                        "type": "final",
                        "answer": answer,
                        "response_id": response_id,
                        "stateless": True,
                        "pending_rule": get_pending_rule_change(),
                        "timing": timing,
                    }
                else:
                    previous_response_id = get_state("previous_response_id")
                    answer, response_id, timing = run_agent(
                        message,
                        previous_response_id=previous_response_id,
                        status_callback=emit_status,
                    )
                    add_message("user", message)
                    add_message("assistant", answer)
                    set_state("previous_response_id", response_id)
                    result = {
                        "type": "final",
                        "answer": answer,
                        "response_id": response_id,
                        "stateless": False,
                        "pending_rule": get_pending_rule_change(),
                        "timing": timing,
                    }
                event_queue.put(result)
        except Exception as exc:
            event_queue.put({"type": "error", "error": str(exc)})
        finally:
            event_queue.put(finished)

    threading.Thread(target=worker, daemon=True).start()

    def generate():
        while True:
            item = event_queue.get()
            if item is finished:
                break
            yield json.dumps(item, ensure_ascii=False) + "\n"

    return StreamingResponse(
        generate(),
        media_type="application/x-ndjson",
        headers={"Cache-Control": "no-cache"},
    )


