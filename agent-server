WEEKDAY_NAMES = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
_SCHEDULER_STOP = threading.Event()
_SCHEDULER_THREAD = None
_TASK_WORKER_THREAD = None


def _parse_run_time(run_time):
    value = str(run_time).strip()
    if not re.fullmatch(r"\d{2}:\d{2}", value):
        raise ValueError("run_time must use 24-hour HH:MM format")
    hour, minute = map(int, value.split(":"))
    if not (0 <= hour <= 23 and 0 <= minute <= 59):
        raise ValueError("run_time must be a valid 24-hour HH:MM time")
    return hour, minute


def _calculate_next_run(frequency, run_time, weekday=None, now=None):
    now = now or datetime.now()
    hour, minute = _parse_run_time(run_time)
    candidate = now.replace(hour=hour, minute=minute, second=0, microsecond=0)

    if frequency == "daily":
        if candidate <= now:
            candidate += timedelta(days=1)
        return candidate

    if frequency == "weekly":
        if weekday is None or not 0 <= int(weekday) <= 6:
            raise ValueError("weekly tasks require weekday 0=Monday through 6=Sunday")
        weekday = int(weekday)
        days_ahead = (weekday - now.weekday()) % 7
        candidate += timedelta(days=days_ahead)
        if candidate <= now:
            candidate += timedelta(days=7)
        return candidate

    raise ValueError("frequency must be daily or weekly")


def create_scheduled_task(name, prompt, frequency, run_time, weekday=None):
    name = str(name).strip()
    prompt = str(prompt).strip()
    frequency = str(frequency).strip().lower()
    if not name or not prompt:
        return {"success": False, "error": "Task name and prompt are required."}
    if frequency not in {"daily", "weekly"}:
        return {"success": False, "error": "Frequency must be daily or weekly."}

    if frequency == "daily":
        weekday = None
    elif weekday is None:
        return {"success": False, "error": "Weekly tasks require a weekday."}

    try:
        next_run = _calculate_next_run(frequency, run_time, weekday)
    except Exception as exc:
        return {"success": False, "error": str(exc)}

    with _db() as conn:
        cur = conn.execute(
            "INSERT INTO scheduled_tasks(name,prompt,frequency,run_time,weekday,next_run_at) "
            "VALUES(?,?,?,?,?,?)",
            (name, prompt, frequency, run_time, weekday, next_run.isoformat(timespec="seconds")),
        )
        conn.commit()
        task_id = cur.lastrowid

    return {
        "success": True,
        "task_id": f"task_{task_id:06d}",
        "name": name,
        "frequency": frequency,
        "run_time": run_time,
        "weekday": weekday,
        "next_run_at": next_run.isoformat(timespec="seconds"),
    }


def _task_id_number(task_id):
    value = str(task_id).strip()
    if value.isdigit():
        return int(value)
    match = re.fullmatch(r"task_(\d+)", value)
    if not match:
        raise ValueError("Task ID must be a number such as 1")
    return int(match.group(1))


def list_scheduled_tasks(include_disabled=True):
    sql = "SELECT * FROM scheduled_tasks"
    params = ()
    if not include_disabled:
        sql += " WHERE enabled = 1"
    sql += " ORDER BY enabled DESC, next_run_at ASC, id ASC"
    with _db() as conn:
        rows = conn.execute(sql, params).fetchall()
    result = []
    for row in rows:
        item = dict(row)
        item["id"] = f"task_{item['id']:06d}"
        item["enabled"] = bool(item["enabled"])
        if item.get("weekday") is not None:
            item["weekday_name"] = WEEKDAY_NAMES[int(item["weekday"])]
        result.append(item)
    return result


def set_scheduled_task_enabled(task_id, enabled):
    try:
        numeric_id = _task_id_number(task_id)
    except ValueError as exc:
        return {"success": False, "error": str(exc)}

    with _db() as conn:
        row = conn.execute("SELECT * FROM scheduled_tasks WHERE id=?", (numeric_id,)).fetchone()
        if not row:
            return {"success": False, "error": "Scheduled task not found."}

        next_run = row["next_run_at"]
        if enabled:
            next_run = _calculate_next_run(
                row["frequency"], row["run_time"], row["weekday"]
            ).isoformat(timespec="seconds")
        conn.execute(
            "UPDATE scheduled_tasks SET enabled=?, next_run_at=? WHERE id=?",
            (1 if enabled else 0, next_run, numeric_id),
        )
        conn.commit()
    return {"success": True, "task_id": task_id, "enabled": bool(enabled), "next_run_at": next_run}


def delete_scheduled_task(task_id):
    try:
        numeric_id = _task_id_number(task_id)
    except ValueError as exc:
        return {"success": False, "error": str(exc)}
    with _db() as conn:
        row = conn.execute("SELECT id FROM scheduled_tasks WHERE id=?", (numeric_id,)).fetchone()
        if not row:
            return {"success": False, "error": "Scheduled task not found."}
        # Preserve already-generated notifications and already-enqueued work,
        # but detach both from the task being deleted.
        conn.execute("UPDATE notifications SET task_id=NULL WHERE task_id=?", (numeric_id,))
        conn.execute("UPDATE scheduled_task_queue SET task_id=NULL WHERE task_id=?", (numeric_id,))
        conn.execute("DELETE FROM scheduled_tasks WHERE id=?", (numeric_id,))
        conn.commit()
    return {"success": True, "task_id": task_id}


