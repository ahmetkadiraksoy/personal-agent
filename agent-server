def init_database():
    with _db() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS state (
                key TEXT PRIMARY KEY,
                value TEXT
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS messages (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                role TEXT NOT NULL,
                content TEXT NOT NULL,
                created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS scheduled_tasks (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                prompt TEXT NOT NULL,
                frequency TEXT NOT NULL CHECK(frequency IN ('daily','weekly')),
                run_time TEXT NOT NULL,
                weekday INTEGER,
                enabled INTEGER NOT NULL DEFAULT 1,
                last_run_at TEXT,
                next_run_at TEXT NOT NULL,
                last_result TEXT,
                created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS scheduled_task_queue (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                task_id INTEGER,
                task_name TEXT NOT NULL,
                task_prompt TEXT NOT NULL,
                frequency TEXT NOT NULL,
                run_time TEXT NOT NULL,
                weekday INTEGER,
                scheduled_for TEXT NOT NULL,
                previous_result TEXT,
                status TEXT NOT NULL DEFAULT 'queued'
                    CHECK(status IN ('queued','running')),
                attempts INTEGER NOT NULL DEFAULT 0,
                last_error TEXT,
                enqueued_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
                started_at TEXT,
                UNIQUE(task_id, scheduled_for)
            )
        """)
        # A server restart may interrupt a worker after it claims a job. Put
        # such jobs back into the persistent FIFO so the backlog resumes.
        conn.execute(
            "UPDATE scheduled_task_queue SET status='queued', started_at=NULL "
            "WHERE status='running'"
        )
        conn.execute("""
            CREATE TABLE IF NOT EXISTS notifications (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                task_id INTEGER,
                title TEXT NOT NULL,
                summary TEXT NOT NULL,
                content TEXT NOT NULL,
                created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
                read_at TEXT,
                FOREIGN KEY(task_id) REFERENCES scheduled_tasks(id)
            )
        """)
        conn.commit()


