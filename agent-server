def _diagnostic_json_chars(value):
    try:
        return len(json.dumps(value, ensure_ascii=False, default=str))
    except Exception:
        return len(str(value))


def _log_api_request_diagnostic(request, request_number):
    instructions = request.get("instructions") or ""
    input_value = request.get("input")
    tools = request.get("tools") or []
    previous_response_id = request.get("previous_response_id")

    console.print("\n[dim][API DIAGNOSTIC][/dim]")
    console.print(f"[dim]request: {request_number}[/dim]")
    console.print(f"[dim]model: {request.get('model', '?')}[/dim]")
    console.print(f"[dim]instructions_chars: {len(str(instructions)):,}[/dim]")
    console.print(f"[dim]input_chars: {_diagnostic_json_chars(input_value):,}[/dim]")
    console.print(f"[dim]tools_count: {len(tools)}[/dim]")
    console.print(f"[dim]tools_chars: {_diagnostic_json_chars(tools):,}[/dim]")
    console.print(f"[dim]previous_response_id: {'yes' if previous_response_id else 'no'}[/dim]")


def _log_api_response_diagnostic(response, request_number):
    usage = getattr(response, "usage", None)
    if usage is None:
        console.print(f"[dim]request {request_number} usage: unavailable[/dim]")
        return

    input_tokens = getattr(usage, "input_tokens", 0) or 0
    output_tokens = getattr(usage, "output_tokens", 0) or 0
    total_tokens = getattr(usage, "total_tokens", 0) or 0
    cached_tokens = 0
    details = getattr(usage, "input_tokens_details", None)
    if details is not None:
        cached_tokens = getattr(details, "cached_tokens", 0) or 0

    console.print(f"[dim]input_tokens: {input_tokens:,}[/dim]")
    console.print(f"[dim]cached_input_tokens: {cached_tokens:,}[/dim]")
    console.print(f"[dim]output_tokens: {output_tokens:,}[/dim]")
    console.print(f"[dim]total_tokens: {total_tokens:,}[/dim]")


def create_response_streaming(status_callback=None, diagnostic_request_number=None, **request):
    """
    Run a Responses API request as a stream so hosted web-search activity can
    be shown immediately, while still returning the completed Response object.
    """
    if API_DIAGNOSTICS and diagnostic_request_number is not None:
        _log_api_request_diagnostic(request, diagnostic_request_number)

    openai_started = time.perf_counter()
    stream = client.responses.create(
        stream=True,
        **request
    )

    final_response = None
    web_notice_shown = False

    for event in stream:
        event_type = getattr(event, "type", "")

        is_web_event = event_type in {
            "response.web_search_call.in_progress",
            "response.web_search_call.searching",
            "response.web_search_call.completed",
        }

        if event_type == "response.output_item.added":
            item = getattr(event, "item", None)

            if getattr(item, "type", None) == "web_search_call":
                is_web_event = True

        if is_web_event and not web_notice_shown:
            web_notice_shown = True
            if status_callback:
                status_callback("🌐 Searching the web...")
            else:
                console.print("\n[cyan]🌐 Searching the web...[/cyan]")

        if event_type == "response.completed":
            final_response = getattr(
                event,
                "response",
                None
            )

    if final_response is None:
        raise RuntimeError(
            "The streamed API response ended without "
            "a response.completed event."
        )

    openai_elapsed = time.perf_counter() - openai_started
    timing = getattr(_USAGE_CONTEXT, "turn_timing", None)
    if timing is not None:
        timing["openai_seconds"] += openai_elapsed
        timing["openai_calls"] += 1

    if API_DIAGNOSTICS and diagnostic_request_number is not None:
        _log_api_response_diagnostic(final_response, diagnostic_request_number)

    return final_response


def run_agent(
    user_message,
    previous_response_id=None,
    status_callback=None
):
    turn_started = time.perf_counter()
    _USAGE_CONTEXT.turn_timing = {
        "openai_seconds": 0.0,
        "openai_calls": 0,
        "web_searches": 0,
    }

    # One status line per distinct activity per user request, even if Luna
    # repeats the same tool in later rounds. Initial semantic memory retrieval
    # is automatic and intentionally silent.
    seen_statuses = set()

    def emit_status_once(message):
        if message in seen_statuses:
            return
        seen_statuses.add(message)
        console.print(f"\n[cyan]{message}[/cyan]")
        if status_callback:
            status_callback(message)

    turn_instructions = build_instructions()
    turn_tools = build_tools()
    turn_context_management = get_context_management()

    request = {
        "model": MODEL,
        "instructions": turn_instructions,
        "input": build_agent_input(user_message),
        "tools": turn_tools,
        "context_management": turn_context_management
    }

    if previous_response_id:
        request["previous_response_id"] = previous_response_id

    diagnostic_request_number = 1
    response = create_response_streaming(
        status_callback=emit_status_once,
        diagnostic_request_number=diagnostic_request_number,
        **request
    )

    record_usage(response)
    turn_web_searches = sum(
        1 for item in getattr(response, "output", [])
        if getattr(item, "type", None) == "web_search_call"
    )
    record_web_searches(response)
    _USAGE_CONTEXT.turn_timing["web_searches"] += turn_web_searches
    tool_rounds = 0

    while True:
        tool_calls = [
            item for item in response.output if item.type == "function_call"
        ]

        if not tool_calls:
            total_seconds = time.perf_counter() - turn_started
            timing = dict(_USAGE_CONTEXT.turn_timing)
            timing["total_seconds"] = total_seconds
            timing["local_seconds"] = max(
                0.0, total_seconds - timing["openai_seconds"]
            )
            return response.output_text, response.id, timing

        if tool_rounds >= MAX_TOOL_ROUNDS:
            raise RuntimeError(
                f"Maximum tool rounds reached ({MAX_TOOL_ROUNDS}). "
                "Increase MAX_TOOL_ROUNDS in .env if this task legitimately needs more."
            )
        tool_rounds += 1

        tool_outputs = []
        for call in tool_calls:
            try:
                arguments = json.loads(call.arguments)
                result = execute_tool(
                    call.name, arguments, status_callback=emit_status_once
                )
            except Exception as e:
                result = {"success": False, "error": str(e)}

            tool_outputs.append({
                "type": "function_call_output",
                "call_id": call.call_id,
                "output": json.dumps(result, ensure_ascii=False)
            })

        diagnostic_request_number += 1
        response = create_response_streaming(
            status_callback=emit_status_once,
            diagnostic_request_number=diagnostic_request_number,
            model=MODEL,
            instructions=turn_instructions,
            previous_response_id=response.id,
            input=tool_outputs,
            tools=turn_tools,
            context_management=turn_context_management
        )

        record_usage(response)
        turn_web_searches = sum(
            1 for item in getattr(response, "output", [])
            if getattr(item, "type", None) == "web_search_call"
        )
        record_web_searches(response)
        _USAGE_CONTEXT.turn_timing["web_searches"] += turn_web_searches



