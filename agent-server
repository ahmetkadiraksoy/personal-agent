        conn.execute(
            "UPDATE notes SET title=?, description=?, content=?, tags=?, updated_at=? WHERE id=?",
            (new_title, new_description, new_content, json.dumps(new_tags, ensure_ascii=False), datetime.now().isoformat(timespec="seconds"), numeric_id),
