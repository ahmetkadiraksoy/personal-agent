        console.print(
            f"[cyan]🧠 Embeddings loaded "
            f"in {time.perf_counter() - started:.2f}s.[/cyan]"
        )

    return _MEMORY_EMBEDDING_MODEL_INSTANCE


def _sync_memory_embeddings(memories):
    """Return embeddings aligned with memories, encoding only new/changed entries."""
    if not memories:
        return np.empty((0, 0), dtype=np.float32)

    cached = {}
    cache_file_existed = MEMORY_EMBEDDINGS_FILE.exists()

    if cache_file_existed:
        try:
            with np.load(
                MEMORY_EMBEDDINGS_FILE,
                allow_pickle=False
            ) as data:
                ids = data["ids"].tolist()
                fingerprints = data["fingerprints"].tolist()
                vectors = data["vectors"]

                for memory_id, fingerprint, vector in zip(
                    ids, fingerprints, vectors
                ):
                    cached[str(memory_id)] = (
                        str(fingerprint),
                        np.asarray(vector, dtype=np.float32)
                    )

        except (OSError, ValueError, KeyError):
            console.print(
                "[yellow]🧠 Memory cache could not be read; rebuilding it.[/yellow]"
            )
            cached = {}
    else:
        pass

    fingerprints = [
        _memory_fingerprint(memory)
        for memory in memories
    ]

    vectors = [None] * len(memories)
    missing_indices = []
    missing_texts = []

    for index, (memory, fingerprint) in enumerate(
        zip(memories, fingerprints)
    ):
        memory_id = str(memory.get("id", ""))
        cached_item = cached.get(memory_id)

        if cached_item and cached_item[0] == fingerprint:
            vectors[index] = cached_item[1]
        else:
            category = str(memory.get("category", "")).strip()
            text = str(memory.get("text", "")).strip()
            embedding_text = (
                f"Category: {category}. {text}"
                if category
                else text
            )
            missing_indices.append(index)
            missing_texts.append("passage: " + embedding_text)

    if missing_texts:
        count = len(missing_texts)
        label = "memory" if count == 1 else "memories"
        console.print(
            f"[cyan]🧠 Creating embeddings for {count} new/updated {label}...[/cyan]"
        )
        started = time.perf_counter()
        model = _get_memory_embedding_model()
        new_vectors = model.encode(
            missing_texts,
            normalize_embeddings=True,
            show_progress_bar=False
        )

        for index, vector in zip(missing_indices, new_vectors):
            vectors[index] = np.asarray(vector, dtype=np.float32)

        console.print(
            f"[cyan]🧠 Created {count} embedding(s) "
            f"in {time.perf_counter() - started:.2f}s.[/cyan]"
        )
    matrix = np.vstack(vectors).astype(np.float32)

    current_ids = [str(memory.get("id", "")) for memory in memories]
    current_fingerprint_map = dict(zip(current_ids, fingerprints))
    cached_fingerprint_map = {
        memory_id: fingerprint
        for memory_id, (fingerprint, _vector) in cached.items()
    }

    cache_needs_write = (
        not cache_file_existed
        or bool(missing_texts)
        or cached_fingerprint_map != current_fingerprint_map
    )

    if cache_needs_write:
        np.savez_compressed(
            MEMORY_EMBEDDINGS_FILE,
            ids=np.asarray(current_ids, dtype=str),
            fingerprints=np.asarray(fingerprints, dtype=str),
            vectors=matrix
        )

    return matrix


def semantic_memory_search(query, limit=None):
    memories = load_memories()

    if not memories:
        return []

    if limit is None:
        limit = MEMORY_RETRIEVAL_LIMIT

    limit = max(1, min(int(limit), len(memories)))
    memory_vectors = _sync_memory_embeddings(memories)
    model = _get_memory_embedding_model()

    started = time.perf_counter()

    query_vector = model.encode(
        "query: " + str(query),
        normalize_embeddings=True,
        show_progress_bar=False
    )

    scores = memory_vectors @ query_vector
    ranking = np.argsort(scores)[::-1][:limit]

    elapsed = time.perf_counter() - started

    return [memories[int(index)] for index in ranking]


def get_automatic_memory_context(user_message):
    memories = semantic_memory_search(
        user_message,
        MEMORY_RETRIEVAL_LIMIT
    )

    return {
        "mode": "semantic",
        "limit": MEMORY_RETRIEVAL_LIMIT,
        "memories": memories
    }


