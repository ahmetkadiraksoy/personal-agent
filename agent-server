def _notes_connection():
    conn = sqlite3.connect(NOTES_DB_FILE)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    conn.execute("""
        CREATE TABLE IF NOT EXISTS categories (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            description TEXT NOT NULL DEFAULT '',
            parent_id INTEGER,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL,
            FOREIGN KEY(parent_id) REFERENCES categories(id) ON DELETE RESTRICT,
            UNIQUE(parent_id, name)
        )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS notes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            title TEXT NOT NULL,
            description TEXT NOT NULL DEFAULT '',
            content TEXT NOT NULL,
            category_id INTEGER,
            tags TEXT,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL,
            FOREIGN KEY(category_id) REFERENCES categories(id) ON DELETE SET NULL
        )
    """)

    # Safe in-place migration from the old flat notes schema.
    cols = {row["name"] for row in conn.execute("PRAGMA table_info(notes)").fetchall()}
    if "description" not in cols:
        conn.execute("ALTER TABLE notes ADD COLUMN description TEXT NOT NULL DEFAULT ''")
    if "category_id" not in cols:
        conn.execute("ALTER TABLE notes ADD COLUMN category_id INTEGER")

    conn.commit()
    return conn


def backup_notes_database():
    """Create one timestamped safety backup before the first schema migration."""
    if not NOTES_DB_FILE.exists():
        return None
    with sqlite3.connect(NOTES_DB_FILE) as conn:
        cols = {row[1] for row in conn.execute("PRAGMA table_info(notes)").fetchall()}
    if "description" in cols and "category_id" in cols:
        return None
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = NOTES_DB_FILE.with_name(f"notes-before-hierarchy-{stamp}.db")
    shutil.copy2(NOTES_DB_FILE, backup)
    return backup


def _parse_note_id(note_id):
    value = str(note_id).strip()
    if value.startswith("note_"):
        value = value[5:]
    try:
        return int(value)
    except ValueError:
        return None


def _parse_category_id(category_id):
    if category_id is None:
        return None
    value = str(category_id).strip()
    if value.startswith("cat_"):
        value = value[4:]
    try:
        return int(value)
    except ValueError:
        return None


def _category_path(conn, category_id):
    if category_id is None:
        return None
    names, seen = [], set()
    current = int(category_id)
    while current is not None and current not in seen:
        seen.add(current)
        row = conn.execute("SELECT id, name, parent_id FROM categories WHERE id=?", (current,)).fetchone()
        if not row:
            break
        names.append(row["name"])
        current = row["parent_id"]
    return " / ".join(reversed(names)) if names else None


def _category_dict(conn, row):
    if not row:
        return None
    item = dict(row)
    item["id"] = f"cat_{int(item['id']):06d}"
    item["parent_id"] = f"cat_{int(item['parent_id']):06d}" if item.get("parent_id") is not None else None
    item["path"] = _category_path(conn, row["id"])
    return item


def _note_dict(row, conn=None):
    item = dict(row)
    try:
        item["tags"] = json.loads(item.get("tags") or "[]")
    except (TypeError, json.JSONDecodeError):
        item["tags"] = []
    # Preserve the real SQLite primary key explicitly for user-facing commands.
    # `id` remains the internal/API identifier for backward compatibility.
    item["db_id"] = int(item["id"])
    item["id"] = f"note_{int(item['id']):06d}"
    if conn is not None:
        item["category_path"] = _category_path(conn, item.get("category_id"))
    else:
        item["category_path"] = None
    if item.get("category_id") is not None:
        item["category_id"] = f"cat_{int(item['category_id']):06d}"
    # Do not expose the obsolete flat category field after migration.
    item.pop("category", None)
    return item


def _load_all_notes():
    with _notes_connection() as conn:
        rows = conn.execute("SELECT * FROM notes ORDER BY id").fetchall()
        return [_note_dict(row, conn) for row in rows]


def list_categories():
    with _notes_connection() as conn:
        rows = conn.execute("SELECT * FROM categories ORDER BY name COLLATE NOCASE, id").fetchall()
        return {"success": True, "categories": [_category_dict(conn, row) for row in rows]}


def create_category(name, description="", parent_id=None):
    name = str(name).strip()
    description = str(description or "").strip()
    if not name:
        return {"success": False, "error": "Category name cannot be empty."}
    parent_numeric = _parse_category_id(parent_id)
    now = datetime.now().isoformat(timespec="seconds")
    with _notes_connection() as conn:
        if parent_id is not None and parent_numeric is None:
            return {"success": False, "error": "Invalid parent category ID."}
        if parent_numeric is not None and not conn.execute("SELECT 1 FROM categories WHERE id=?", (parent_numeric,)).fetchone():
            return {"success": False, "error": "Parent category not found."}
        try:
            cur = conn.execute(
                "INSERT INTO categories(name, description, parent_id, created_at, updated_at) VALUES(?,?,?,?,?)",
                (name, description, parent_numeric, now, now),
            )
            conn.commit()
        except sqlite3.IntegrityError:
            return {"success": False, "error": "A category with that name already exists under the same parent."}
        row = conn.execute("SELECT * FROM categories WHERE id=?", (cur.lastrowid,)).fetchone()
        return {"success": True, "category": _category_dict(conn, row)}


def update_category(category_id, name=None, description=None, parent_id=None, change_parent=False):
    numeric = _parse_category_id(category_id)
    if numeric is None:
        return {"success": False, "error": "Invalid category ID."}
    with _notes_connection() as conn:
        row = conn.execute("SELECT * FROM categories WHERE id=?", (numeric,)).fetchone()
        if not row:
            return {"success": False, "error": "Category not found."}
        new_name = row["name"] if name is None else str(name).strip()
        new_description = row["description"] if description is None else str(description).strip()
        new_parent = row["parent_id"]
        if change_parent:
            new_parent = _parse_category_id(parent_id)
            if parent_id is not None and new_parent is None:
                return {"success": False, "error": "Invalid parent category ID."}
            if new_parent == numeric:
                return {"success": False, "error": "A category cannot be its own parent."}
            # Prevent cycles.
            current = new_parent
            while current is not None:
                if current == numeric:
                    return {"success": False, "error": "Category move would create a cycle."}
                p = conn.execute("SELECT parent_id FROM categories WHERE id=?", (current,)).fetchone()
                if not p:
                    return {"success": False, "error": "Parent category not found."}
                current = p["parent_id"]
        now = datetime.now().isoformat(timespec="seconds")
        try:
            conn.execute(
                "UPDATE categories SET name=?, description=?, parent_id=?, updated_at=? WHERE id=?",
                (new_name, new_description, new_parent, now, numeric),
            )
            conn.commit()
        except sqlite3.IntegrityError:
            return {"success": False, "error": "A category with that name already exists under the destination parent."}
        row = conn.execute("SELECT * FROM categories WHERE id=?", (numeric,)).fetchone()
        _sync_note_embeddings(_load_all_notes())
        return {"success": True, "category": _category_dict(conn, row)}


def delete_category(category_id):
    numeric = _parse_category_id(category_id)
    if numeric is None:
        return {"success": False, "error": "Invalid category ID."}
    with _notes_connection() as conn:
        row = conn.execute("SELECT * FROM categories WHERE id=?", (numeric,)).fetchone()
        if not row:
            return {"success": False, "error": "Category not found."}
        child_count = conn.execute("SELECT COUNT(*) FROM categories WHERE parent_id=?", (numeric,)).fetchone()[0]
        note_count = conn.execute("SELECT COUNT(*) FROM notes WHERE category_id=?", (numeric,)).fetchone()[0]
        if child_count or note_count:
            return {"success": False, "error": "Category is not empty. Move its notes/subcategories first."}
        conn.execute("DELETE FROM categories WHERE id=?", (numeric,))
        conn.commit()
    return {"success": True, "deleted_id": f"cat_{numeric:06d}", "name": row["name"]}


def move_note(note_id, category_id=None):
    numeric_id = _parse_note_id(note_id)
    category_numeric = _parse_category_id(category_id)
    if numeric_id is None:
        return {"success": False, "error": "Invalid note ID."}
    if category_id is not None and category_numeric is None:
        return {"success": False, "error": "Invalid category ID."}
    with _notes_connection() as conn:
        if not conn.execute("SELECT 1 FROM notes WHERE id=?", (numeric_id,)).fetchone():
            return {"success": False, "error": "Note not found."}
        if category_numeric is not None and not conn.execute("SELECT 1 FROM categories WHERE id=?", (category_numeric,)).fetchone():
            return {"success": False, "error": "Category not found."}
        conn.execute(
            "UPDATE notes SET category_id=?, updated_at=? WHERE id=?",
            (category_numeric, datetime.now().isoformat(timespec="seconds"), numeric_id),
        )
        conn.commit()
    _sync_note_embeddings(_load_all_notes())
    ordered = list_notes(limit=200)["notes"]
    display_number = next((i for i,n in enumerate(ordered,1) if n["id"] == f"note_{numeric_id:06d}"), None)
    return {"success": True, "id": f"note_{numeric_id:06d}", "display_number": display_number}


def _note_fingerprint(note):
    # Routing index deliberately excludes full content.
    payload = "\n".join([
        str(note.get("id", "")),
        str(note.get("category_path", "")),
        str(note.get("title", "")),
        str(note.get("description", "")),
    ])
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def _sync_note_embeddings(notes):
    if not notes:
        if NOTE_EMBEDDINGS_FILE.exists():
            NOTE_EMBEDDINGS_FILE.unlink()
        return np.empty((0, 0), dtype=np.float32)

    cached = {}
    if NOTE_EMBEDDINGS_FILE.exists():
        try:
            with np.load(NOTE_EMBEDDINGS_FILE, allow_pickle=False) as data:
                for note_id, fingerprint, vector in zip(data["ids"].tolist(), data["fingerprints"].tolist(), data["vectors"]):
                    cached[str(note_id)] = (str(fingerprint), np.asarray(vector, dtype=np.float32))
        except (OSError, ValueError, KeyError):
            cached = {}

    fingerprints = [_note_fingerprint(note) for note in notes]
    vectors = [None] * len(notes)
    missing_indices, missing_texts = [], []
    for i, (note, fingerprint) in enumerate(zip(notes, fingerprints)):
        cached_item = cached.get(str(note["id"]))
        if cached_item and cached_item[0] == fingerprint:
            vectors[i] = cached_item[1]
        else:
            text = (
                f"Category: {note.get('category_path') or 'Uncategorized'}. "
                f"Title: {note.get('title','')}. "
                f"Description: {note.get('description','')}"
            )
            missing_indices.append(i)
            missing_texts.append("passage: " + text)

    if missing_texts:
        model = _get_memory_embedding_model()
        new_vectors = model.encode(missing_texts, normalize_embeddings=True, show_progress_bar=False)
        for i, vector in zip(missing_indices, new_vectors):
            vectors[i] = np.asarray(vector, dtype=np.float32)

    matrix = np.vstack(vectors).astype(np.float32)
    np.savez_compressed(
        NOTE_EMBEDDINGS_FILE,
        ids=np.asarray([str(note["id"]) for note in notes], dtype=str),
        fingerprints=np.asarray(fingerprints, dtype=str),
        vectors=matrix,
    )
    return matrix


def create_note(title, description, content, category_id=None, tags=None):
