# Stateless mode is a temporary, server-side scratch conversation.
# It is intentionally kept only in RAM and is discarded when stateless mode ends.
STATELESS_STATE = {
    "previous_response_id": None,
    "messages": [],
    "last_query": None,
}

_USAGE_CONTEXT = threading.local()

def _usage_bucket():
    return STATELESS_USAGE if getattr(_USAGE_CONTEXT, "stateless", False) else SESSION_USAGE

def reset_usage(bucket):
    bucket.clear()
    bucket.update(empty_usage())

def clear_stateless_state():
    STATELESS_STATE["previous_response_id"] = None
    STATELESS_STATE["messages"] = []
    STATELESS_STATE["last_query"] = None
    reset_usage(STATELESS_USAGE)


def record_usage(response):
    usage = getattr(response, "usage", None)

    if usage is None:
        return

    input_tokens = getattr(usage, "input_tokens", 0) or 0
    output_tokens = getattr(usage, "output_tokens", 0) or 0
    total_tokens = getattr(usage, "total_tokens", 0) or 0

    cached_input_tokens = 0
    input_details = getattr(
        usage,
        "input_tokens_details",
        None
    )

    if input_details is not None:
        cached_input_tokens = getattr(
            input_details,
            "cached_tokens",
            0
        ) or 0

    _usage_bucket()["api_requests"] += 1
    _usage_bucket()["input_tokens"] += input_tokens
    _usage_bucket()["cached_input_tokens"] += cached_input_tokens
    _usage_bucket()["output_tokens"] += output_tokens
    _usage_bucket()["total_tokens"] += total_tokens


def record_web_searches(response):
    count = sum(
        1
        for item in getattr(response, "output", [])
        if getattr(item, "type", None) == "web_search_call"
    )

    if count:
        _usage_bucket()["web_searches"] += count


