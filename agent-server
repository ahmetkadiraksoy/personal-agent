def load_rules():
    if not RULES_FILE.exists():
        RULES_FILE.write_text('{"rules": []}\n', encoding="utf-8")
    try:
        data = json.loads(RULES_FILE.read_text(encoding="utf-8"))
    except Exception:
        data = {"rules": []}
    rules = data.get("rules", []) if isinstance(data, dict) else []
    rules = [r for r in rules if isinstance(r, dict) and r.get("id") and r.get("instruction")]

    # One-time compatibility migration: an older rule forced one web search by
    # default. Replace that constraint with adaptive search breadth so simple
    # questions stay efficient while discovery/research tasks can search wider.
    adaptive_search_rule = (
        "When using web search, prioritize answer quality, accuracy, verification, "
        "and adequate coverage. Use as many searches as are useful to answer the "
        "request well, while avoiding redundant or substantially similar searches. "
        "Simple factual questions may require only one search. Discovery, monitoring, "
        "recommendation, comparison, verification, or broad research tasks may require "
        "several searches. Continue searching when additional searches are likely to "
        "materially improve coverage, accuracy, or verification, and stop when further "
        "searching is unlikely to materially improve the answer."
    )
    changed = False
    for rule in rules:
        instruction = str(rule.get("instruction", ""))
        lowered = instruction.lower()
        if (
            "one focused search by default" in lowered
            or "one search by default" in lowered
            or "use the minimum number of searches" in lowered
        ):
            rule["instruction"] = adaptive_search_rule
            changed = True
    if changed:
        save_rules(rules)

    return rules


def save_rules(rules):
    tmp = RULES_FILE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps({"rules": rules}, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(RULES_FILE)


def next_rule_id(rules):
    nums = []
    for r in rules:
        m = re.fullmatch(r"rule_(\d+)", str(r.get("id", "")))
        if m:
            nums.append(int(m.group(1)))
    return f"rule_{max(nums, default=0)+1:03d}"


def get_pending_rule_change():
    raw = get_state("pending_rule_change")
    if not raw:
        return None
    try:
        return json.loads(raw)
    except Exception:
        delete_state("pending_rule_change")
        return None


def propose_rule_change(action, instruction=None, scope="general", rule_id=None):
    # Only create a proposal. Never modify rules here.
    action = str(action).strip().lower()
    if action not in {"add", "update", "delete"}:
        return {"success": False, "error": "Invalid rule action."}
    rules = load_rules()
    existing = None
    if action in {"update", "delete"}:
        existing = next((r for r in rules if r.get("id") == rule_id), None)
        if not existing:
            return {"success": False, "error": f"Rule not found: {rule_id}"}
    if action in {"add", "update"} and not str(instruction or "").strip():
        return {"success": False, "error": "Rule instruction cannot be empty."}
    proposal = {
        "action": action,
        "rule_id": rule_id,
        "scope": str(scope or "general").strip().lower(),
        "instruction": str(instruction or "").strip() if instruction is not None else None,
        "old_rule": existing,
    }
    set_state("pending_rule_change", json.dumps(proposal, ensure_ascii=False))
    return {"success": True, "requires_approval": True, "proposal": proposal}


def apply_pending_rule_change():
    proposal = get_pending_rule_change()
    if not proposal:
        return {"success": False, "error": "No pending rule change."}
    rules = load_rules()
    action = proposal["action"]
    if action == "add":
        rule = {
            "id": next_rule_id(rules),
            "scope": proposal.get("scope") or "general",
            "instruction": proposal["instruction"],
        }
        rules.append(rule)
    elif action == "update":
        idx = next((i for i,r in enumerate(rules) if r.get("id") == proposal.get("rule_id")), None)
        if idx is None:
            delete_state("pending_rule_change")
            return {"success": False, "error": "Rule no longer exists."}
        rule = dict(rules[idx])
        rule["scope"] = proposal.get("scope") or rule.get("scope", "general")
        rule["instruction"] = proposal["instruction"]
        rules[idx] = rule
    else:
        idx = next((i for i,r in enumerate(rules) if r.get("id") == proposal.get("rule_id")), None)
        if idx is None:
            delete_state("pending_rule_change")
            return {"success": False, "error": "Rule no longer exists."}
        rule = rules.pop(idx)
    save_rules(rules)
    delete_state("pending_rule_change")
    return {"success": True, "action": action, "rule": rule}


def reject_pending_rule_change():
    proposal = get_pending_rule_change()
    delete_state("pending_rule_change")
    return {"success": True, "rejected": proposal}


def build_instructions():
    rules = load_rules()
    if not rules:
        return SYSTEM_PROMPT
    rendered = "\n".join(
        f"- [{r.get('id')}] ({r.get('scope','general')}) {r.get('instruction')}"
        for r in rules
    )
    return SYSTEM_PROMPT + "\n\nUSER-APPROVED AGENT RULES\n" + rendered + "\n"

