def remember(category, text):
    category = category.strip().lower()
    category = "_".join(category.split())

    if not category:
        return {
            "success": False,
            "error": "Category cannot be empty."
        }

    if not text.strip():
        return {
            "success": False,
            "error": "Memory cannot be empty."
        }

    memories = load_memories()

    now = datetime.now().isoformat(
        timespec="seconds"
    )

    memory = {
        "id": generate_memory_id(memories),
        "category": category,
        "text": text.strip(),
        "saved_at": now,
        "updated_at": now
    }

    memories.append(memory)
    save_memories(memories)

    return {
        "success": True,
        "id": memory["id"],
        "display_number": len(memories),
        "category": category
    }



def update_memory(memory_id, text):
    memory_id = str(memory_id).strip()
    new_text = str(text).strip()

    if not memory_id:
        return {"success": False, "error": "Memory ID cannot be empty."}

    if not new_text:
        return {"success": False, "error": "Replacement memory cannot be empty."}

    memories = load_memories()

    for display_number, memory in enumerate(memories, 1):
        if memory.get("id") == memory_id:
            memory["text"] = new_text
            memory["updated_at"] = datetime.now().isoformat(
                timespec="seconds"
            )
            save_memories(memories)

            return {
                "success": True,
                "id": memory_id,
                "display_number": display_number,
                "category": memory.get("category"),
                "text": new_text
            }

    return {
        "success": False,
        "error": f"Memory not found: {memory_id}"
    }


def delete_memory(memory_id):
    memory_id = str(memory_id).strip()

    if not memory_id:
        return {"success": False, "error": "Memory ID cannot be empty."}

    memories = load_memories()

    for index, memory in enumerate(memories):
        if memory.get("id") == memory_id:
            display_number = index + 1
            deleted = memories.pop(index)
            save_memories(memories)

            return {
                "success": True,
                "deleted_id": memory_id,
                "display_number": display_number,
                "category": deleted.get("category")
            }

    return {
        "success": False,
        "error": f"Memory not found: {memory_id}"
    }


def get_memories(categories):
    memories = load_memories()

    if "all" in categories:
        return {
            "memories": memories
        }

    selected = [
        memory
        for memory in memories
        if memory.get("category") in categories
    ]

    return {
        "memories": selected
    }


